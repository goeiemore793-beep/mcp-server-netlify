{
  "name": "mcp-server-netlify",
  "version": "1.0.0",
  "description": "MCP server with paid access via Paddle, deployed on Netlify",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:netlify": "npm run build && npm run build:functions",
    "build:functions": "netlify functions:build",
    "start": "netlify dev",
    "dev": "netlify dev",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "server",
    "netlify",
    "paddle"
  ],
  "netlify": {
    "functions": {
      "directory": "functions-build",
      "include": [
        "src/**/*.ts"
      ]
    }
  }
}
