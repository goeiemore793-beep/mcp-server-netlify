# .env.example

# Server Configuration
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Authentication
AUTH_SECRET=your_super_secret_jwt_key_change_this_in_production

# Paid Endpoint Configuration
PAID_ENDPOINT_URL=https://api.paidendpoint.com/v1
PAID_ENDPOINT_API_KEY=your_paid_endpoint_api_key_here

# Database Configuration
DATABASE_URL=mongodb://localhost:27017/paid-mcp

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Cache Configuration
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT=100

# CORS Configuration
CORS_ORIGIN=*─────────────────────────
# Replace with your actual connection string
DATABASE_URL=mongodb://localhost:27017/paid-mcp

# ── Monitoring / Error Tracking ───────────────────────────────────────────────
# Sentry: https://sentry.io/settings/account/api/
# Leave blank in development to disable
SENTRY_DSN=