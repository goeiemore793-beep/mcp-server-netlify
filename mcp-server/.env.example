# MCP Server Environment Configuration

# Paddle Credentials
PADDLE_VENDOR_ID=your_paddle_vendor_id_here
PADDLE_VENDOR_AUTH_CODE=your_paddle_vendor_auth_code_here

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Server Configuration
PORT=8080
NODE_ENV=production

# Optional: Log level (info, debug, warn, error)
LOG_LEVEL=info

# Optional: Database connection (for production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mcp_server
# DB_USER=postgres
# DB_PASSWORD=your_password